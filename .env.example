# Copier ce fichier en .env (deja ignore par git) et y coller la cle.
# Laisser LLM_PROVIDER=ollama pour rester 100 % local.

LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Facultatif : surcharge des modeles par defaut
# NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Facultatif : stockage PostgreSQL au lieu de SQLite (couche donnees).
# Laisser absent pour rester sur le fichier SQLite local (audit_history.db).
# DATABASE_URL=postgresql://utilisateur:mot_de_passe@hote:5432/ram_security
